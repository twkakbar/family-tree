# ============================================================
# Family Tree – Docker Compose environment
#
# Copy this file to `.env` and adjust values.
# NEVER commit the real `.env` file.
# ============================================================

# --- Compose file selection ---------------------------------
# Development: merging base + dev override makes `docker compose up`
# start the dev stack (hot reload, exposed ports).
# Production (VM): remove/comment these two lines, or set
# COMPOSE_FILE=docker-compose.yml
COMPOSE_FILE=docker-compose.yml;docker-compose.dev.yml
COMPOSE_PATH_SEPARATOR=;

# --- Images -------------------------------------------------
# Local development builds images from source. In production you can
# point these at Docker Hub (pushed by .github/workflows/deploy.yml)
# and run `docker compose pull` instead of building on the VM:
#   BACKEND_IMAGE=twkakbar/family-tree-backend:latest
#   FRONTEND_IMAGE=twkakbar/family-tree-frontend:latest
#   NGINX_IMAGE=twkakbar/family-tree-nginx:latest
BACKEND_IMAGE=family-tree/backend:local
FRONTEND_IMAGE=family-tree/frontend:local
NGINX_IMAGE=family-tree/nginx:local

# --- Ports --------------------------------------------------
NGINX_HTTP_PORT=80        # public entry point (nginx reverse proxy)
POSTGRES_PORT=5432        # host port for Postgres (exposed in dev only)
BACKEND_PORT=8080         # host port for the API (exposed in dev only)
FRONTEND_PORT=3000        # host port for Next.js dev server (dev only)

# --- PostgreSQL ---------------------------------------------
POSTGRES_USER=familytree
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=familytree

# --- Backend ------------------------------------------------
# REQUIRED. Min 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-min-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h    # 30 days
COOKIE_SECURE=false       # MUST be true in production behind HTTPS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
RUN_MIGRATIONS=true       # apply pending DB migrations on startup
LOG_LEVEL=debug           # debug | info | warn | error

# --- Bootstrap admin (optional) ------------------------------
# If both email and password are set, an admin account is created
# on startup when it does not exist yet.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
