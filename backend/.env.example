# ============================================================
# Backend environment – for running the API NATIVELY (hybrid dev).
# Copy to backend/.env  (auto-loaded in non-production).
# In Docker these values come from compose (root .env) instead.
# NEVER commit the real .env file.
# ============================================================

APP_ENV=development           # development | production | test
HTTP_PORT=8080
LOG_LEVEL=debug               # debug | info | warn | error

# --- Database -------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=familytree
DB_PASSWORD=change-me-in-production
DB_NAME=familytree
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
RUN_MIGRATIONS=true

# --- Auth ------------------------------------------------------
# REQUIRED, min 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-min-32-characters
JWT_ISSUER=family-tree-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
BCRYPT_COST=12
COOKIE_SECURE=false           # true in production (HTTPS)
COOKIE_DOMAIN=                # empty = host-only cookie

# --- HTTP ------------------------------------------------------
# Comma-separated origins allowed for cross-origin calls (hybrid dev).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
# Comma-separated CIDRs/IPs of trusted reverse proxies (empty = trust none).
# In Docker production set to the compose network, e.g. 172.16.0.0/12
TRUSTED_PROXIES=

# --- Uploads ----------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# --- Bootstrap admin (optional) ----------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# --- Royal family seed (singleton public tree) ---------------
ROYAL_FAMILY_NAME=Kesultanan Aceh
ROYAL_FAMILY_DESCRIPTION=Silsilah keluarga kerajaan Aceh untuk dijelajahi publik.

# --- Registration email (optional; all-or-nothing) ------------
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
APP_PUBLIC_URL=
