# ============================================================
# Frontend environment – copy to frontend/.env.local for native dev.
# NEXT_PUBLIC_* values are inlined into the browser bundle AT BUILD TIME.
# NEVER put secrets here.
# ============================================================

# Base path of the API as seen from the BROWSER. Keep it relative ("/api/v1"):
# nginx (prod) and Next rewrites (dev) route it to the backend same-origin.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Display name used in the UI and metadata.
NEXT_PUBLIC_APP_NAME=Family Tree

# Where the Next SERVER proxies /api/* during development (rewrites).
# Native dev: http://localhost:8080  |  Docker dev: http://backend:8080
API_PROXY_TARGET=http://localhost:8080
