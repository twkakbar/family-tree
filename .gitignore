# ============================================================
# Family Tree – root .gitignore
# ============================================================

# --- Environment / secrets (NEVER commit real env files) ----
.env
.env.*
!.env.example

# --- OS / editor -------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json

# --- Go (backend) ------------------------------------------
backend/bin/
backend/tmp/
backend/coverage.out
backend/uploads/

# --- Node / Next.js (frontend) -----------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/*.tsbuildinfo
frontend/.eslintcache
frontend/next-env.d.ts
npm-debug.log*

# --- Runtime data ------------------------------------------
uploads/
*.log
